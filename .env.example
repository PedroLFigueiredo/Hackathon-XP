# Copie este arquivo para .env e preencha. O .env não vai para o git.

# Supabase: Project Settings > Database > Connection string > Session pooler (porta 5432).
# Se a senha tiver caracteres como @ # / : ? ela precisa estar em URL-encoding (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@<regiao>.pooler.supabase.com:5432/postgres

# OpenAI
OPENAI_API_KEY=
