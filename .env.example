# Em Development, o .env na raiz do repositório ou da aplicação é lido para a conexão e para a chave da OpenAI.
# Só as chaves abaixo são lidas do .env. Fakes e Whisper:ModelPath ficam no appsettings.json ou na linha de comando.

# Também aceita DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
ConnectionStrings__Supabase=Host=SEU_HOST;Port=5432;Database=postgres;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require

# Análise por IA. Sem a chave, a aplicação preserva só a transcrição.
OPENAI_API_KEY=
