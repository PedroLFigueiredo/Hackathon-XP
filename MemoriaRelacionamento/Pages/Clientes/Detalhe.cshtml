@page "{id:guid}"
@model MemoriaRelacionamento.Pages.Clientes.DetalheModel
@using MemoriaRelacionamento.Models
@inject IConfiguration Configuration
@{ ViewData["Title"] = Model.Cliente?.Nome ?? "Perfil do cliente"; }
<a asp-page="Index">← Clientes</a>
<div asp-validation-summary="All" class="text-danger"></div>
@if (!Model.BancoConfigurado) { <partial name="_DatabaseNotice" /> }
@if (Model.Cliente is { } cliente)
{
    <h1>@cliente.Nome</h1>
    <p>@cliente.Email · @cliente.Telefone</p><p>Perfil financeiro: @cliente.PerfilFinanceiro · Personalidade: @cliente.Personalidade</p>
    @if (Configuration.GetValue("Fakes:Transcricao", false) || Configuration.GetValue("Fakes:Analise", false))
    {
        <div class="alert alert-warning">Modo de demonstração: transcrição ou análise fictícias estão ativadas.</div>
    }
    else
    {
        <div class="alert alert-info">O áudio é transcrito localmente. A análise automática ainda não está disponível; confira a transcrição no histórico.</div>
    }
    <h2>Adicionar conversa</h2>
    <form method="post" asp-page-handler="Texto" class="mb-4">
        <label asp-for="Data">Data da conversa</label><input asp-for="Data" type="date" class="form-control" required />
        <label asp-for="Texto">Transcrição</label><textarea asp-for="Texto" class="form-control" rows="4" minlength="50" required></textarea>
        <button class="btn btn-primary mt-2">Processar texto</button>
    </form>
    <form method="post" asp-page-handler="Audio" enctype="multipart/form-data" class="mb-4">
        <label for="data-audio">Data da conversa</label><input name="Data" id="data-audio" type="date" value="@Model.Data.ToString("yyyy-MM-dd")" class="form-control" required />
        <label asp-for="Audio">Áudio (WAV, MP3 ou M4A, até 200 MB)</label><input asp-for="Audio" type="file" accept=".wav,.mp3,.m4a" class="form-control" required />
        <button class="btn btn-primary mt-2">Processar áudio</button>
    </form>
    var ultima = Model.Conversas.FirstOrDefault(x => x.Status == StatusConversa.Concluida);
    @if (ultima is not null)
    {
        <h2>Última conversa — @ultima.Data.ToString("dd/MM/yyyy")</h2>
        @if (ultima.Sentimento is not null) { <p>Tom da conversa — estimado pela IA: @ultima.Sentimento</p> }
        <ul>@foreach (var item in ultima.Resumo) { <li>@item</li> }</ul>
    }
    <h2>Memória do relacionamento</h2>
    @if (Model.Insights.Count == 0) { <p>Envie uma conversa para alimentar a memória deste cliente.</p> }
    @foreach (var grupo in Model.Insights.GroupBy(x => x.Categoria))
    {
        <h3>@grupo.Key</h3>
        @foreach (var insight in grupo)
        {
            <p>@insight.Conteudo</p>
            <details><summary>Trecho de origem</summary><blockquote>@insight.TrechoDeOrigem</blockquote></details>
        }
    }
    <h2>Próximas ações</h2>
    @if (Model.Tarefas.Count == 0) { <p>Nenhuma tarefa registrada.</p> }
    <ul>@foreach (var tarefa in Model.Tarefas) { <li>@tarefa.Descricao — @(tarefa.Concluida ? "Concluída" : "Pendente") @tarefa.DataOpcional?.ToString("dd/MM/yyyy")</li> }</ul>
    <h2>Histórico</h2>
    @foreach (var conversa in Model.Conversas)
    {
        <div class="border rounded p-3 mb-2">
            <strong>@conversa.Data.ToString("dd/MM/yyyy") · @conversa.Origem</strong>
            <span data-status-id="@conversa.Id" data-status="@conversa.Status">@conversa.Status</span>
            @if (conversa.Transcricao?.StartsWith("Transcrição fictícia de demonstração.", StringComparison.Ordinal) == true)
            {
                <p class="text-warning">Esta conversa foi criada com a transcrição de demonstração. Envie o áudio novamente para obter a transcrição real.</p>
            }
            @if (conversa.Status == StatusConversa.Erro)
            {
                <p class="text-danger">@conversa.MensagemDeErro</p>
                <form method="post" asp-page-handler="Reprocessar">
                    <input type="hidden" name="conversaId" value="@conversa.Id" />
                    <button class="btn btn-primary">Tentar novamente</button>
                </form>
            }
            <details><summary>@(Model.TranscricoesParciais.Contains(conversa.Id) ? "Transcrição parcial — processamento interrompido" : "Transcrição")</summary><p data-transcricao-id="@conversa.Id" style="white-space: pre-wrap">@conversa.Transcricao</p></details>
        </div>
    }
}
@section Scripts {
    <script src="~/js/conversa-status.js" asp-append-version="true"></script>
}
